        "productName": "Theme Forge Nebular Fusion",
        "version": "0.6.1",
        "identifier": "ai.knowledgeforge.themeforge.nebularfusion",
        "build": {
          "beforeBuildCommand": "npm run build",
          "frontendDist": "../dist"
        },
        "app": {
          "withGlobalTauri": false,
          "windows": [
            {
              "label": "main",
              "title": "Theme Forge Nebular Fusion",
              "create": false,
              "width": 1180,
              "height": 820,
              "minWidth": 760,
              "minHeight": 620,
              "resizable": true,
              "fullscreen": false
            }
