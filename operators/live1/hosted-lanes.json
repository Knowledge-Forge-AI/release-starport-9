{
  "schema": "rs9.hosted-lanes.v1alpha1",
  "production_enabled": false,
  "lanes": [
    {
      "lane": "unit",
      "system": "generation",
      "runner": "ubuntu-24.04",
      "timeout_minutes": 15,
      "kind": "source-test"
    },
    {
      "lane": "pins",
      "system": "generation",
      "runner": "ubuntu-24.04",
      "timeout_minutes": 30,
      "module": "rs9.hosted_pins",
      "artifact_name": "candidate-pins-generation",
      "required_gates": [
        "pinned-targets-readback",
        "container-digests-resolved",
        "nixpkgs-pin-resolved"
      ],
      "custody_required": false
    },
    {
      "lane": "authenticate",
      "system": "generation",
      "runner": "ubuntu-24.04",
      "timeout_minutes": 30,
      "module": "rs9.hosted_candidate",
      "artifact_name": "candidate-authenticate-generation",
      "required_gates": [
        "release-authentication",
        "credential-sanitization"
      ],
      "custody_required": false
    },
    {
      "lane": "wheels",
      "system": "aarch64-darwin",
      "runner": "macos-15",
      "timeout_minutes": 90,
      "module": "rs9.hosted_wheels",
      "artifact_name": "candidate-wheels-aarch64-darwin",
      "required_gates": [
        "wheel-deterministic-build",
        "wheel-offline-isolation",
        "wheel-lifecycle-install-test",
        "wheel-native-verifier"
      ],
      "custody_required": true,
      "allowed_not_run": {
        "wheel-offline-isolation": "darwin-offline-isolation-unsupported"
      },
      "required_products": [
        "theme-forge-stellar-burst",
        "theme-forge-stellar-loom",
        "theme-forge-solar-sail",
        "theme-forge-nebular-fusion"
      ]
    },
    {
      "lane": "wheels",
      "system": "x86_64-linux",
      "runner": "ubuntu-24.04",
