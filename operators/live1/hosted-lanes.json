      "lane": "deb",
      "system": "arm64",
      "runner": "ubuntu-24.04-arm",
      "timeout_minutes": 90,
      "family": "deb",
      "module": "rs9.hosted_deb",
      "artifact_name": "candidate-deb-arm64",
